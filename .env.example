# ───────────────────────── AgentLab configuration ─────────────────────────
# Copy to .env and adjust. Every value has a working local default.

# ---- Collector API (apps/api) ----
# SQLite for bare-metal dev; docker-compose injects PostgreSQL automatically.
AGENTLAB_DATABASE_URL=sqlite:///./agentlab.db

# Comma-separated API keys for the event write path.
# Empty = open local mode (no auth). Example: AGENTLAB_API_KEYS=dev-key,ci-key
AGENTLAB_API_KEYS=

# Origins allowed to call the API from the browser (dev servers).
AGENTLAB_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- SDK / demo workflow (examples/) ----
AGENTLAB_ENDPOINT=http://localhost:8000
AGENTLAB_API_KEY=dev-key
AGENTLAB_PROJECT=demo-project

# Kill-switch: set to 1 to make the SDK a complete no-op.
# AGENTLAB_DISABLED=1

# ---- Model Gateway BYOK (v0.7), local-first ----
# Placeholders only — never commit a real key. Keys are read by the server,
# held in memory, and never stored, returned to the browser, or logged.
# The 'mock' provider needs none of these. Leave blank to keep a provider
# "not configured". Test a provider from Settings → Model Gateway.
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# OLLAMA_BASE_URL=http://localhost:11434
# OPENROUTER_API_KEY=sk-or-your-openrouter-key
